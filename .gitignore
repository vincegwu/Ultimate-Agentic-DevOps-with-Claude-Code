

# Ignore Terraform state and backup files
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform/
terraform/.terraform.lock.hcl

# Ignore local settings and secrets
*.local.json
*.env

# Ignore VS Code settings
.vscode/

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore build and deployment artifacts
*.log

# Ignore images cache (if any)
images/cache/

# Ignore node_modules (if accidentally added)
node_modules/

# Ignore Python cache (if accidentally added)
__pycache__/
*.pyc

# Ignore GitHub Actions artifacts
.github/

# Ignore other common files
*.bak
*.swp

# Do not ignore site HTML/CSS/images
!index.html
!style.css
!privacy.html
!terms.html
!images/
